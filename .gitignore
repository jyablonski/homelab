# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/

# Python version and build artifacts
.python-version
build/
dist/

# dbt build artifacts
apps/dbt/target/
apps/dbt/logs/
apps/dbt/dbt_packages/
